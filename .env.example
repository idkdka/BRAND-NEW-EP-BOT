# Your bot token from the Discord Developer Portal (Bot tab)
DISCORD_TOKEN=your-bot-token-here

# Your application ID (General Information tab). Only needed for deploy-global.
CLIENT_ID=your-application-id-here

# Where to store data. Locally ./data/db.json is fine.
# On Railway/Render, point this at a mounted volume so data survives restarts,
# e.g. /data/db.json
DATABASE_PATH=./data/db.json

# Roblox Open Cloud API key for /grouprank and /groupaccept (create at
# https://create.roblox.com/dashboard/credentials — give it group member
# management permission on your group). Leave blank if not using those commands.
ROBLOX_API_KEY=

# Roblox account session cookie (.ROBLOSECURITY value), required ONLY for
# /groupkick, /groupunkick, and /groupkicked. Roblox's Open Cloud API has no
# group-ban endpoints, so these fall back to the old cookie-based Group Ban
# API, which needs an actual logged-in session instead of an API key.
#
# SECURITY: this cookie IS a login to that account — anyone who gets it can do
# anything that account can do (not just group actions). Use a dedicated alt
# ranked above whoever you'll be kicking, never your main account, and never
# commit this value or share it. Leave blank to disable those 3 commands.
ROBLOX_COOKIE=
